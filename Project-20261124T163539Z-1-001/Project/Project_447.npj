            "data": "{\n    \"connections\": [\n        {\n            \"in_id\": \"{40db2b04-97ae-403d-8ad7-e8e1a1affcbd}\",\n            \"in_index\": 0,\n            \"out_id\": \"{3a90a4a3-9a15-4a83-a9bc-300727e6e094}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{6bbb8e17-0703-487a-b988-f775b42182ee}\",\n            \"in_index\": 0,\n            \"out_id\": \"{a27e7071-8ae4-4a97-be93-772524dc3168}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{3a90a4a3-9a15-4a83-a9bc-300727e6e094}\",\n            \"in_index\": 0,\n            \"out_id\": \"{a27e7071-8ae4-4a97-be93-772524dc3168}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{a27e7071-8ae4-4a97-be93-772524dc3168}\",\n            \"in_index\": 0,\n            \"out_id\": \"{6bbb8e17-0703-487a-b988-f775b42182ee}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{ec682a79-160e-4d89-8580-0096fd2bbb37}\",\n            \"in_index\": 0,\n            \"out_id\": \"{d04acbaa-4097-43d0-9a5d-e2200522756d}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{d04acbaa-4097-43d0-9a5d-e2200522756d}\",\n            \"in_index\": 0,\n            \"out_id\": \"{3a90a4a3-9a15-4a83-a9bc-300727e6e094}\",\n            \"out_index\": 0\n        }\n    ],\n    \"nodes\": [\n        {\n            \"id\": \"{6bbb8e17-0703-487a-b988-f775b42182ee}\",\n            \"model\": {\n                \"name\": \"ButtonRun\"\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -238,\n                \"y\": -221\n            }\n        },\n        {\n            \"id\": \"{ec682a79-160e-4d89-8580-0096fd2bbb37}\",\n            \"model\": {\n                \"height\": 140,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 0,\n                \"width\": 225\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 102,\n                \"y\": -34\n            }\n        },\n        {\n            \"id\": \"{40db2b04-97ae-403d-8ad7-e8e1a1affcbd}\",\n            \"model\": {\n                \"height\": 140,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 0,\n                \"width\": 225\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 221,\n                \"y\": -238\n            }\n        },\n        {\n            \"id\": \"{3a90a4a3-9a15-4a83-a9bc-300727e6e094}\",\n            \"model\": {\n                \"data\": {\n                    \"curr_tap\": 1,\n                    \"draw_roi\": true,\n                    \"enable_tracking\": false,\n                    \"font_scale\": 1.2,\n                    \"font_thickness\": 2,\n                    \"frame_buffer\": 5,\n                    \"is_roi_polygon\": false,\n                    \"map_det_cfgs\": [\n                        {\n                            \"backend_name\": \"CUDA\",\n                            \"config_name\": \"1\",\n                            \"config_path\": \"C:/Users/PC/Downloads/plate_model/plate_model\"\n                        }\n                    ],\n                    \"max_dist\": 150,\n                    \"nms\": 0.4,\n                    \"rect_thickness\": 2,\n                    \"result_drawing\": true,\n                    \"roi_h\": 50000,\n                    \"roi_polygon\": {\n                    },\n                    \"roi_w\": 50000,\n                    \"roi_x\": 0,\n                    \"roi_y\": 0,\n                    \"show_confidence\": true,\n                    \"text_drawing\": false,\n                    \"this_config_name\": \"1\",\n                    \"thresh\": 50,\n                    \"txt_offset\": 5\n                },\n                \"name\": \"DeepDetect \",\n                \"node_enable\": true,\n                \"obj_colors\": {\n                    \"array\": [\n                    ]\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 51,\n                \"y\": -221\n            }\n        },\n        {\n            \"id\": \"{d04acbaa-4097-43d0-9a5d-e2200522756d}\",\n            \"model\": {\n                \"data\": {\n                    \"auto_start\": false,\n                    \"caption\": \"\",\n                    \"code\": \"import sys, os, cv2, re, time, json, base64, difflib, traceback\\r\\nimport urllib.request\\r\\nimport numpy as np\\r\\n\\r\\ntry:\\r\\n\\tsys.stdout.reconfigure(encoding=\\\"utf-8\\\", errors=\\\"replace\\\")\\r\\n\\tsys.stderr.reconfigure(encoding=\\\"utf-8\\\", errors=\\\"replace\\\")\\r\\nexcept Exception:\\r\\n\\tpass\\r\\n\\r\\nimport easyocr\\r\\n\\r\\n# ==========================================\\r\\n# SETTINGS\\r\\n#   SLOT_ID  = ช่องจอดของกล้องตัวนี้ (1 กล้อง = 1 ช่อง) ต้องแก้ให้ตรงทุกกล้อง เช่น A1-1, A1-2\\r\\n#   SERVER_URL ถ้าเซิร์ฟเวอร์อยู่คนละเครื่อง เช่น http://192.168.1.50:8000/api/seen\\r\\n# ==========================================\\r\\nSERVER_URL = \\\"http://127.0.0.1:8000/api/seen\\\"\\r\\nSLOT_ID = \\\"A1-1\\\"\\r\\nSEND_INTERVAL = 5.0     # ส่งทุกกี่วินาที (ทำหน้าที่บอกเซิร์ฟเวอร์ว่ารถยังจอดอยู่)\\r\\nMIN_PLATE_CONF = 0.4\\r\\nOCR_INTERVAL = 1.0      # หลัง OCR เสร็จ รออย่างน้อยกี่วินาทีก่อนอ่านเฟรมถัดไป (เฟรมที่เหลือผ่านไปเฉยๆ)\\r\\n\\r\\nPROVINCES = [\\r\\n \\\"กรุงเทพมหานคร\\\",\\\"กระบี่\\\",\\\"กาญจนบุรี\\\",\\\"กาฬสินธุ์\\\",\\\"กำแพงเพชร\\\",\\\"ขอนแก่น\\\",\\\"จันทบุรี\\\",\\r\\n \\\"ฉะเชิงเทรา\\\",\\\"ชลบุรี\\\",\\\"ชัยนาท\\\",\\\"ชัยภูมิ\\\",\\\"ชุมพร\\\",\\\"เชียงราย\\\",\\\"เชียงใหม่\\\",\\\"ตรัง\\\",\\\"ตราด\\\",\\r\\n \\\"ตาก\\\",\\\"นครนายก\\\",\\\"นครปฐม\\\",\\\"นครพนม\\\",\\\"นครราชสีมา\\\",\\\"นครศรีธรรมราช\\\",\\\"นครสวรรค์\\\",\\\"นนทบุรี\\\",\\r\\n \\\"นราธิวาส\\\",\\\"น่าน\\\",\\\"บึงกาฬ\\\",\\\"บุรีรัมย์\\\",\\\"ปทุมธานี\\\",\\\"ประจวบคีรีขันธ์\\\",\\\"ปราจีนบุรี\\\",\\\"ปัตตานี\\\",\\r\\n \\\"พระนครศรีอยุธยา\\\",\\\"พะเยา\\\",\\\"พังงา\\\",\\\"พัทลุง\\\",\\\"พิจิตร\\\",\\\"พิษณุโลก\\\",\\\"เพชรบุรี\\\",\\\"เพชรบูรณ์\\\",\\r\\n \\\"แพร่\\\",\\\"ภูเก็ต\\\",\\\"มหาสารคาม\\\",\\\"มุกดาหาร\\\",\\\"แม่ฮ่องสอน\\\",\\\"ยโสธร\\\",\\\"ยะลา\\\",\\\"ร้อยเอ็ด\\\",\\\"ระนอง\\\",\\r\\n \\\"ระยอง\\\",\\\"ราชบุรี\\\",\\\"ลพบุรี\\\",\\\"ลำปาง\\\",\\\"ลำพูน\\\",\\\"เลย\\\",\\\"ศรีสะเกษ\\\",\\\"สกลนคร\\\",\\\"สงขลา\\\",\\\"สตูล\\\",\\r\\n \\\"สมุทรปราการ\\\",\\\"สมุทรสงคราม\\\",\\\"สมุทรสาคร\\\",\\\"สระแก้ว\\\",\\\"สระบุรี\\\",\\\"สิงห์บุรี\\\",\\\"สุโขทัย\\\",\\r\\n \\\"สุพรรณบุรี\\\",\\\"สุราษฎร์ธานี\\\",\\\"สุรินทร์\\\",\\\"หนองคาย\\\",\\\"หนองบัวลำภู\\\",\\\"อ่างทอง\\\",\\\"อำนาจเจริญ\\\",\\r\\n \\\"อุดรธานี\\\",\\\"อุตรดิตถ์\\\",\\\"อุทัยธานี\\\",\\\"อุบลราชธานี\\\",\\r\\n]\\r\\n\\r\\nprint(\\\"Loading EasyOCR...\\\")\\r\\nreader = easyocr.Reader([\\\"th\\\"], gpu=False)\\r\\nprint(\\\"EasyOCR ready! Slot:\\\", SLOT_ID, \\\"Server:\\\", SERVER_URL)\\r\\n\\r\\n_last_sent_time = 0.0\\r\\n_last_ocr_done = 0.0\\r\\n\\r\\n\\r\\n# ==========================================\\r\\n# HELPER FUNCTIONS\\r\\n# ==========================================\\r\\ndef clean_text(t):\\r\\n\\treturn \\\"\\\".join(str(t).split())\\r\\n\\r\\n\\r\\ndef match_province(t):\\r\\n\\tm = difflib.get_close_matches(t, PROVINCES, n=1, cutoff=0.6)\\r\\n\\treturn m[0] if m else None\\r\\n\\r\\n\\r\\ndef looks_like_plate(t):\\r\\n\\treturn (re.search(r\\\"\\\\d\\\", t) is not None\\r\\n\\t\\t\\tand re.search(r\\\"[ก-ฮ]\\\", t) is not None\\r\\n\\t\\t\\tand 4 <= len(t) <= 9)\\r\\n\\r\\n\\r\\n# ==========================================\\r\\n# SEND TO SERVER\\r\\n# ==========================================\\r\\ndef send_plate(crop, plate, province, conf):\\r\\n\\tglobal _last_sent_time\\r\\n\\tnow = time.time()\\r\\n\\tif now - _last_sent_time < SEND_INTERVAL:\\r\\n\\t\\treturn\\r\\n\\t_last_sent_time = now\\r\\n\\r\\n\\tok, buf = cv2.imencode(\\\".jpg\\\", crop)\\r\\n\\tif not ok:\\r\\n\\t\\tprint(\\\"Could not encode image\\\")\\r\\n\\t\\treturn\\r\\n\\r\\n\\tpayload = {\\r\\n\\t\\t\\\"slot_id\\\": SLOT_ID,\\r\\n\\t\\t\\\"plate\\\": plate,\\r\\n\\t\\t\\\"province\\\": province or \\\"\\\",\\r\\n\\t\\t\\\"confidence\\\": float(conf),\\r\\n\\t\\t\\\"image_b64\\\": base64.b64encode(buf.tobytes()).decode(\\\"ascii\\\"),\\r\\n\\t}\\r\\n\\ttry:\\r\\n\\t\\treq = urllib.request.Request(\\r\\n\\t\\t\\tSERVER_URL,\\r\\n\\t\\t\\tdata=json.dumps(payload).encode(\\\"utf-8\\\"),\\r\\n\\t\\t\\theaders={\\\"Content-Type\\\": \\\"application/json\\\"},\\r\\n\\t\\t\\tmethod=\\\"POST\\\",\\r\\n\\t\\t)\\r\\n\\t\\twith urllib.request.urlopen(req, timeout=3) as r:\\r\\n\\t\\t\\tprint(\\\"Server:\\\", r.read().decode(\\\"utf-8\\\"))\\r\\n\\texcept Exception as e:\\r\\n\\t\\tprint(\\\"Send failed:\\\", e)\\r\\n\\r\\n\\r\\n# ==========================================\\r\\n# OCR PROCESSING\\r\\n# ==========================================\\r\\ndef process_image(img):\\r\\n\\ttry:\\r\\n\\t\\tif img is None:\\r\\n\\t\\t\\treturn img\\r\\n\\t\\tframe = cv2.cvtColor(img, cv2.COLOR_GRAY2BGR) if len(img.shape) == 2 else img.copy()\\r\\n\\r\\n\\t\\tresults = reader.readtext(frame)\\r\\n\\t\\tprint(\\\"OCR lines:\\\", len(results))\\r\\n\\r\\n\\t\\tplate = None\\r\\n\\t\\tprov = None\\r\\n\\r\\n\\t\\tfor bbox, text, conf in results:\\r\\n\\t\\t\\tt = clean_text(text)\\r\\n\\t\\t\\tif not t:\\r\\n\\t\\t\\t\\tcontinue\\r\\n\\t\\t\\tbox = cv2.boundingRect(np.array(bbox, dtype=np.int32))\\r\\n\\t\\t\\tis_plate = looks_like_plate(t)\\r\\n\\t\\t\\tp = None if is_plate else match_province(t)\\r\\n\\t\\t\\tprint(\\\"  read:\\\", repr(t), \\\"conf:\\\", round(float(conf), 2),\\r\\n\\t\\t\\t\\t  \\\"-> plate\\\" if is_plate else (\\\"-> province \\\" + p if p else \\\"-> ignored\\\"))\\r\\n\\r\\n\\t\\t\\tif is_plate and conf >= MIN_PLATE_CONF:\\r\\n\\t\\t\\t\\tif plate is None or conf > plate[1]:\\r\\n\\t\\t\\t\\t\\tplate = (t, conf, box)\\r\\n\\t\\t\\telif p:\\r\\n\\t\\t\\t\\tprov = (p, box)\\r\\n\\r\\n\\t\\tif plate is None:\\r\\n\\t\\t\\tprint(\\\"No plate line found in this frame\\\")\\r\\n\\t\\t\\treturn frame\\r\\n\\r\\n\\t\\tboxes = [plate[2]] + ([prov[1]] if prov else [])\\r\\n\\t\\tx1 = min(b[0] for b in boxes); y1 = min(b[1] for b in boxes)\\r\\n\\t\\tx2 = max(b[0] + b[2] for b in boxes); y2 = max(b[1] + b[3] for b in boxes)\\r\\n\\t\\tpad = 10\\r\\n\\t\\tx1 = max(0, x1 - pad); y1 = max(0, y1 - pad)\\r\\n\\t\\tx2 = min(frame.shape[1], x2 + pad); y2 = min(frame.shape[0], y2 + pad)\\r\\n\\r\\n\\t\\tsend_plate(frame[y1:y2, x1:x2].copy(), plate[0], prov[0] if prov else None, plate[1])\\r\\n\\r\\n\\t\\tcv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)\\r\\n\\t\\tcv2.putText(frame, plate[0], (x1, max(20, y1 - 8)),\\r\\n\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)\\r\\n\\t\\treturn frame\\r\\n\\r\\n\\texcept Exception:\\r\\n\\t\\ttraceback.print_exc()\\r\\n\\t\\treturn img\\r\\n\\r\\n\\r\\n# ==========================================\\r\\n# CiRA CORE REQUEST HANDLER\\r\\n# ==========================================\\r\\ndef handle_request(req):\\r\\n\\tglobal _last_ocr_done\\r\\n\\tpayload, img = getReqData(req)\\r\\n\\r\\n\\tif img is None:\\r\\n\\t\\tprint(\\\"Image is None: True\\\")\\r\\n\\t\\treturn makeRespData(payload, img)\\r\\n\\r\\n\\t# ยังไม่ถึงเวลาอ่านรอบใหม่ ปล่อยเฟรมผ่านไปเฉยๆ (ไม่ให้ OCR ซ้อนกันจนวิดีโอหน่วง)\\r\\n\\tif time.time() - _last_ocr_done < OCR_INTERVAL:\\r\\n\\t\\treturn makeRespData(payload, img)\\r\\n\\r\\n\\tprint(\\\"PAYLOAD:\\\", str(payload)[:400])\\r\\n\\tt0 = time.time()\\r\\n\\toutput_img = process_image(img)\\r\\n\\tprint(\\\"OCR time: %.2f s\\\" % (time.time() - t0))\\r\\n\\t_last_ocr_done = time.time()\\r\\n\\treturn makeRespData(payload, output_img)\",\n                    \"editor_setting\": {\n                        \"autoComplete\": {\n                            \"caseSensitivity\": true,\n                            \"enable\": true,\n                            \"threshold\": 3\n                        },\n                        \"indent\": {\n                            \"enable\": true\n                        },\n                        \"theme\": \"Material Dark\",\n                        \"whitespace\": {\n                            \"enable\": false,\n                            \"size\": 2\n                        }\n                    },\n                    \"icon\": \":/cira_bernoulli_python_plus/model/python_plus.png\",\n                    \"not_use_image\": false,\n                    \"python_path\": \"C:/Users/PC/AppData/Local/Programs/Python/Python310/python.exe\"\n                },\n                \"name\": \"Python+\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -68,\n                \"y\": -51\n            }\n        },\n        {\n            \"id\": \"{a27e7071-8ae4-4a97-be93-772524dc3168}\",\n            \"model\": {\n                \"data\": {\n                },\n                \"name\": \"WebCam \",\n                \"node_enable\": true,\n                \"setting\": {\n                    \"webcamUUID\": \"DB3-972\"\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -119,\n                \"y\": -221\n            }\n        }\n    ],\n    \"scene_data\": {\n        \"flow_view_fix\": false,\n        \"flow_view_pos_x\": -284.20000000000005,\n        \"flow_view_pos_y\": -361.5500000000018,\n        \"flow_view_zoom_factor\": 0.9090909090909091,\n        \"scene_version\": 1\n    }\n}\n",
